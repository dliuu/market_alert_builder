# Copy to .env and fill in. .env is gitignored — never commit real keys.
# All values come from your Supabase project (see docs/09-supabase-setup.md).

# --- Database (worker: Alembic + SQLAlchemy) ---
# Supabase → Project Settings → Database → Connection string → "URI".
# Use the DIRECT connection (port 5432) for migrations.
# The "+psycopg" driver marker is required by SQLAlchemy 2 / psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres:PLACEHOLDER@db.PLACEHOLDER.supabase.co:5432/postgres

# Pooled connection (port 6543, transaction mode) for the running web/worker app.
# Optional in M0; wire it in when the app opens real connections.
DATABASE_POOL_URL=postgresql+psycopg://postgres.PLACEHOLDER:PLACEHOLDER@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Supabase API (web app) ---
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://PLACEHOLDER.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PLACEHOLDER
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER

# --- Market data (worker: ingest) ---
# Tiingo daily EOD OHLCV — free tier, personal/non-commercial, no card.
# Sign up at https://www.tiingo.com and copy the API token from your account.
TIINGO_API_KEY=PLACEHOLDER

# FinancialData.net (M16). Premium tier. Empty ⇒ open brief runs synthetic.
FDN_API_KEY=

# --- Narration (worker: stage ⑤) ---
# Claude API key for prose. Optional: with no key the brief ships tables-only —
# narration is non-fatal by design (M8). Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=PLACEHOLDER
# Model override for narration (defaults to claude-opus-4-8).
# NARRATION_MODEL=claude-opus-4-8

# --- Service-to-service ---
# Shared secret for the worker -> web POST /api/render/:brief_id call.
# Generate one with:  openssl rand -hex 32
RENDER_SHARED_SECRET=PLACEHOLDER

# --- Delivery (worker: stage ⑦, M9) ---
# Resend API key. Create at https://resend.com → API Keys (starts "re_").
RESEND_API_KEY=PLACEHOLDER
# Base URL of the web app hosting the render endpoint (no trailing slash).
# Local: http://localhost:3000 · Prod: your Vercel URL.
WEB_RENDER_URL=http://localhost:3000
# From header. The address must be on your Resend-verified sending subdomain.
BRIEF_FROM=Session Brief <brief@brief.PLACEHOLDER_DOMAIN>
# Default recipient for `worker send` until per-user delivery exists.
BRIEF_RECIPIENT=PLACEHOLDER_YOUR_EMAIL

# --- Scheduler + dead-man's switch (worker: M10) ---
# Healthchecks.io ping URL. The scheduler pings it after every run (a real send,
# a quiet skip, or a correctly-skipped holiday) and pings <url>/fail on a crash.
# A dead worker stops pinging and the check goes red. Create a check at
# https://healthchecks.io and paste its ping URL. Empty ⇒ scheduler runs without
# a heartbeat (fine for local testing, not for the unattended deploy).
HEALTHCHECKS_URL=PLACEHOLDER
# Per-fire dead-man's-switch checks (M13/M14), one per scheduled run so a silent
# morning is distinguishable from a silent evening. Empty ⇒ no ping.
# HEALTHCHECKS_REFIT_URL=
# HEALTHCHECKS_PM_URL=
# HEALTHCHECKS_AM_URL=
# HEALTHCHECKS_OPEN_URL=
# Minutes after the session close to send (docs/02: 16:45 = close + 45). Optional.
# SEND_DELAY_MINUTES=45
# How long to poll Tiingo for today's EOD bar before deferring, and how often
# (seconds). Optional — defaults are 1200 / 90.
# BAR_POLL_TIMEOUT_S=1200
# BAR_POLL_INTERVAL_S=90
# When the poll gives up, the close re-fires on this interval until the cutoff
# below, rather than crashing (D20, amended). The cutoff is ET wall-clock on the
# session's own date and MUST stay before midnight — the job derives its session
# from the current ET date, so a retry past midnight would brief the wrong day.
# Optional — defaults are 30 minutes, until 23:45 ET.
# BAR_RETRY_INTERVAL_MINUTES=30
# BAR_RETRY_UNTIL_ET_HOUR=23
# BAR_RETRY_UNTIL_ET_MINUTE=45
# Attribution PM/AM reconcile (M11): correct the stored return when the
# synthetic PM day-return and the official day-return differ by more than this
# (fraction; 0.001 = 10 bps). Optional.
# RECONCILE_TOL=0.001

# --- Open brief (worker: M14) ---
# Fixed wall-clock ET send time, unlike the close brief's close-plus-delay.
# Optional — defaults are 08:15 ET.
# OPEN_SEND_ET_HOUR=8
# OPEN_SEND_ET_MINUTE=15

# --- Pre-market capture (worker: M15) ---
# The capture stamp §3's header renders ("pre-market · 08:12 ET"). Optional —
# defaults are 08:12 ET.
# PREMARKET_CAPTURE_ET_HOUR=8
# PREMARKET_CAPTURE_ET_MINUTE=12
# How many prior sessions of pre-market volume §3's multiple averages, and the
# minimum it needs before it will report one. Optional — defaults are 10 / 5.
# PREMARKET_VOL_WINDOW=10
# PREMARKET_VOL_MIN_OBS=5

# --- Chinese A-share briefs (worker_cn: CN-M1…CN-M4) ---
# The CN pair fires on Asia/Shanghai wall-clock over a separate CNY book: open
# 09:10 CST (20 min before the 09:30 bell) and close 15:00 + CN_SEND_DELAY_MINUTES.
# All of these are read by worker_cn/config.py and are optional — every one has a
# working default — but the two Healthchecks URLs are effectively required for an
# unattended deploy (see below).
#
# Dead-man's switch, one per CN fire, same reasoning as the US per-fire checks:
# empty ⇒ NO PING AT ALL, so a CN job that dies fails silently. The machine's
# restart policy is `no`, so nothing else would tell you. Create two checks at
# https://healthchecks.io and paste their ping URLs before the first live CN
# session.
# HEALTHCHECKS_CN_OPEN_URL=
# HEALTHCHECKS_CN_CLOSE_URL=
# Whether CN bars come from the live vendor (true) or the deterministic synthetic
# provider (anything else). Truthy values are "1" and "true", case-insensitive.
# This is a hand-set flag, a documented exception to D29's "derive, never
# hand-flip": TIINGO_API_KEY presence already means "US book live" and cannot
# also encode the CN answer. While false, every CN brief stamps
# "cn_bars.synthetic" into data_quality.stale and the templates show the banner.
# Flipping it to true requires the synthetic-history purge AND the outstanding-CN-
# claim drain first — see cn/docs/milestones.md. Optional — defaults to false.
# CN_BARS_LIVE=false
# Minutes after the 15:00 CST close to send the close brief. This is the knob
# CN-Q4 is open against: nobody has yet verified Tiingo publishes the A-share EOD
# bar by 15:20 on a real session day, and if it lands late the fix is this value,
# not code. Optional — defaults to 20 (a 15:20 send).
# CN_SEND_DELAY_MINUTES=20
# Wall-clock send time for the CN open brief, Asia/Shanghai. Optional — 09:10.
# CN_OPEN_SEND_HOUR=9
# CN_OPEN_SEND_MINUTE=10
# How long the CN close polls for today's bar before giving up, and how often
# (seconds). A missing bar fails loudly and never sends stale (D20). Optional —
# defaults are 1200 / 90.
# CN_BAR_POLL_TIMEOUT_S=1200
# CN_BAR_POLL_INTERVAL_S=90
