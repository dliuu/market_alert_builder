# Copy to .env and fill in. .env is gitignored — never commit real keys.
# All values come from your Supabase project (see docs/09-supabase-setup.md).

# --- Database (worker: Alembic + SQLAlchemy) ---
# Supabase → Project Settings → Database → Connection string → "URI".
# Use the DIRECT connection (port 5432) for migrations.
# The "+psycopg" driver marker is required by SQLAlchemy 2 / psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres:PLACEHOLDER@db.PLACEHOLDER.supabase.co:5432/postgres

# Pooled connection (port 6543, transaction mode) for the running web/worker app.
# Optional in M0; wire it in when the app opens real connections.
DATABASE_POOL_URL=postgresql+psycopg://postgres.PLACEHOLDER:PLACEHOLDER@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Supabase API (web app) ---
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://PLACEHOLDER.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PLACEHOLDER
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER

# --- Market data (worker: ingest) ---
# Tiingo daily EOD OHLCV — free tier, personal/non-commercial, no card.
# Sign up at https://www.tiingo.com and copy the API token from your account.
TIINGO_API_KEY=PLACEHOLDER

# --- Narration (worker: stage ⑤) ---
# Claude API key for prose. Optional: with no key the brief ships tables-only —
# narration is non-fatal by design (M8). Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=PLACEHOLDER
# Model override for narration (defaults to claude-opus-4-8).
# NARRATION_MODEL=claude-opus-4-8

# --- Service-to-service ---
# Shared secret for the worker -> web POST /api/render/:brief_id call.
# Generate one with:  openssl rand -hex 32
RENDER_SHARED_SECRET=PLACEHOLDER

# --- Delivery (worker: stage ⑦, M9) ---
# Resend API key. Create at https://resend.com → API Keys (starts "re_").
RESEND_API_KEY=PLACEHOLDER
# Base URL of the web app hosting the render endpoint (no trailing slash).
# Local: http://localhost:3000 · Prod: your Vercel URL.
WEB_RENDER_URL=http://localhost:3000
# From header. The address must be on your Resend-verified sending subdomain.
BRIEF_FROM=Session Brief <brief@brief.PLACEHOLDER_DOMAIN>
# Default recipient for `worker send` until per-user delivery exists.
BRIEF_RECIPIENT=PLACEHOLDER_YOUR_EMAIL
